generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  REQUESTED
  APPROVED
  DECLINED
  PAID
  CANCELLED
}

enum BookingMessageRole {
  RENTER
  OWNER
}

model Festival {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  state       String
  startsAt    DateTime
  endsAt      DateTime
  description String
  campNotes   String
  vans        VanFestival[]
  bookings    BookingRequest[]
}

enum VanStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model Owner {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  supabaseUserId String?  @unique
  vans           Van[]
  createdAt      DateTime @default(now())
}

model Van {
  id                   String     @id @default(cuid())
  ownerId              String
  owner                Owner      @relation(fields: [ownerId], references: [id])
  name                 String
  location             String
  year                 Int?
  make                 String?
  model                String?
  trim                 String?
  sleeps               Int
  seatbelts            Int?
  transmission         String?
  fuelType             String?
  minNights            Int        @default(2)
  weekendRateCents     Int?
  coverPhotoUrl        String?
  status               VanStatus  @default(DRAFT)
  publishedAt          DateTime?
  nightlyRateCents     Int
  cleaningFeeCents     Int
  securityDepositCents Int
  festivalFriendly     Boolean    @default(true)
  description          String
  amenities            String
  rules                String
  availableFestivals   String?
  festivals            VanFestival[]
  photos               VanPhoto[]
  bookings             BookingRequest[]
  createdAt            DateTime   @default(now())
}

model VanPhoto {
  id          String @id @default(cuid())
  vanId       String
  van         Van    @relation(fields: [vanId], references: [id], onDelete: Cascade)
  storagePath String
  publicUrl   String
  sortOrder   Int    @default(0)
  isCover     Boolean @default(false)
}

model VanFestival {
  vanId      String
  festivalId String
  van        Van @relation(fields: [vanId], references: [id])
  festival   Festival @relation(fields: [festivalId], references: [id])

  @@id([vanId, festivalId])
}

model Bundle {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  priceCents  Int
  description String
  includes    String
  bookings    BookingRequest[]
}

model BookingRequest {
  id          String @id @default(cuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id])
  vanId       String
  van         Van @relation(fields: [vanId], references: [id])
  bundleId    String
  bundle      Bundle @relation(fields: [bundleId], references: [id])
  renterName  String
  renterEmail String
  renterPhone String?
  guests      Int
  pickupType  String
  notes       String?
  arrivalAt   DateTime @db.Date
  departureAt DateTime @db.Date
  nights      Int
  renterMessage String?
  tripNeeds     String?
  declineReason String?
  approvedAt    DateTime?
  status      BookingStatus @default(REQUESTED)
  totalCents               Int
  depositPaidCents         Int       @default(0)
  stripeCheckoutSessionId  String?   @unique
  stripePaymentIntentId    String?   @unique
  paidAt                   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  messages                 BookingMessage[]
  accessToken              BookingAccessToken?
}

model BookingMessage {
  id         String             @id @default(cuid())
  bookingId  String
  booking    BookingRequest     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderRole BookingMessageRole
  body       String
  createdAt  DateTime           @default(now())

  @@index([bookingId, createdAt])
}

model BookingAccessToken {
  id        String         @id @default(cuid())
  bookingId String         @unique
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tokenHash String         @unique
  createdAt DateTime       @default(now())
  expiresAt DateTime
}

model OwnerLead {
  id                   String   @id @default(cuid())
  ownerName            String
  email                String
  phone                String?
  vanYearMakeModel     String
  sleeps               Int
  homeCity             String
  nightlyRateCents     Int
  festivalAvailability String
  photosUrl            String?
  notes                String?
  createdAt            DateTime @default(now())
}
